{
  "manifest_version": 3,
  "name": "AdHush Assistant",
  "version": "0.3.0",
  "description": "Companion for the AdHush ad blocker: per-site switch, pause, and element blocking.",
  "key": "",
  "permissions": ["nativeMessaging", "activeTab", "scripting", "contextMenus"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "AdHush", "default_icon": { "32": "icon32.png", "128": "icon128.png" } },
  "icons": { "32": "icon32.png", "128": "icon128.png" }
}
