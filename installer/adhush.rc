// Windows resources shared by adhush-tray.exe, adhush-service.exe and adhush-core.exe:
// the app icon (Start menu, taskbar, Apps list, Explorer) and version information.
// Compiled by each crate's build.rs with embed-resource.
#include <winver.h>

1 ICON "adhush.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,3,1,0
PRODUCTVERSION  0,3,1,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "AdHush"
      VALUE "FileDescription",  "AdHush"
      VALUE "FileVersion",      "0.3.1"
      VALUE "ProductName",      "AdHush"
      VALUE "ProductVersion",   "0.3.1"
      VALUE "LegalCopyright",   "AdHush"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
